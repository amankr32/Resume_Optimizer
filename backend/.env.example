# Copy this file to .env and fill in your own values.
# Never commit .env — it holds real secrets.

# Required
MONGO_URI=mongodb://localhost:27017/ats-checker
JWT_SECRET=replace-with-a-long-random-string

# Optional (defaults shown)
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=7d
COOKIE_NAME=arr_token

# Comma-separated list of origins allowed to call this API.
# Must include whatever origin your frontend dev server runs on.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Required for AI analysis (resume scoring, rewrites) to work.
# Get a key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NOTE: If you change PORT above, also update the proxy target in
# frontend/vite.config.js so the frontend can still reach the API.
